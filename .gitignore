# Ignore everything by default
*

# Track root project files
!.gitignore
!README.md
!load-env.ps1

# Track Terraform directory
!terraform/
terraform/*

# Track required Terraform source/config files
!terraform/*.tf
!terraform/.env.example

!terraform/.terraform.lock.hcl

# Never track Terraform local/generated files
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log
terraform/crash.*.log

# Track future project directories
!functions/
!functions/**
!adf/
!adf/**
!sql/
!sql/**
!powerbi/
!powerbi/**
!docs/
!docs/**

# Keep local data excluded
data/